# Main REST API Gateway (AiAgentBackendSwarmStack -> ApiUrl output).
# Example: https://abcd1234.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_API_BASE_URL=

# AgentCore case-websocket pre-sign API Gateway
# (SwarmAgentCoreStack -> SwarmAgentCoreApiGatewayUrl output).
# Example: https://wxyz5678.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_WS_PRESIGN_API_BASE_URL=
