# Swarm AgentCore agent - local dev env template
# Copy to .env and fill in values for `docker compose up`.

AWS_DEFAULT_REGION=us-east-1
CHECKPOINT_S3_BUCKET_NAME=
ASSETS_BUCKET_NAME=
WORKFLOWS_TABLE_NAME=

BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

AGENT_STEP_LIMIT=25
AGENT_RECURSION_LIMIT=250

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=swarm-case-agentcore
